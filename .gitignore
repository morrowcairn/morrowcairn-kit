__pycache__/
*.pyc
.venv/
venv/
node_modules/
.DS_Store

# The do-not-publish list lives outside every repository, at ~/.config/morrowcairn/lists/<id> (the id in kit.list-id),
# and never in a tracked file. This entry exists so a stray copy at the repo root cannot be committed by accident.
leak-pattern
*.leak-pattern

# Local operator notes -- machine-specific identity and remotes -- at .local/operator-notes.md, named
# in CLAUDE.md. Never tracked; leak-detection/pre-commit also refuses anything staged under .local/.
.local/
