# The kit's stand-in machine (decisions log §284 ruling 1, §288): an org-like Linux box for the kit's git-level
# suites. Built by tests/standin/run.sh, which passes BASE as an image pinned by digest, so a red run and a green run
# are on the same image. It adds only what the suites need from the distribution (git, python3) and a user without
# sudo. Nothing from the host is baked in: the runner mounts a one-commit snapshot of the kit, the gitleaks binary,
# the entry script and the IT hook read-only at run time. Kit-only: kit-manifest.txt classes tests/standin/ kit, so no
# release ships it.
# APT_SOURCES, when the runner passes it, replaces the image's apt sources: a release past its end of life (Debian 11)
# is served only from archive.debian.org, whose release files are past their expiry date, so apt's expiry check is off
# for that build alone. The base stays pinned; the packages are what the archive or the mirror serves when it's built.
ARG BASE
FROM ${BASE}
ARG APT_SOURCES=""
RUN opt=""; if [ -n "$APT_SOURCES" ]; then printf '%s\n' "$APT_SOURCES" > /etc/apt/sources.list \
        && rm -f /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources && opt="-o Acquire::Check-Valid-Until=false"; fi \
    && apt-get $opt update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends git python3 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -u 2000 -s /bin/bash tester
