#!/usr/bin/env bash
#
# stub-hook — the hook git runs in a pinned spawn. bin/kit-pin copies this file to .git/hooks/pre-commit and
# .git/hooks/pre-push; git runs it from there, through this clone's own hooks path when an org sets one, and it runs
# that org's hook and the project's own first (below). It reads the clone's kit.pin (release=vX.Y.Z and
# manifest=sha256:<64 hex>), finds that release's install under $KIT_INSTALL_ROOT (default
# ~/.local/share/morrowcairn/releases), and checks, in order: the install exists; its RELEASE names the pinned
# release; its MANIFEST.sha256 hashes to the pin's value; every file matches its manifest line, and nothing
# else is there; this stub equals the release's copy; and, at a commit in a clone that chains a hooks path, that
# kit-pin relays every hook that path holds (below). Then it runs the release's hook of the same name, with
# the same arguments and stdin, and with KIT_INSTALL exported for that hook and the project's own checks.
#
# REFUSES when any check fails. The pin is the anchor: tracked in the spawn, outside the install, so an edit
# to any file of the install (the list reader made to exit 0 while sourced, say) changes a hash the pin holds,
# and is refused before any of the install's code runs.
#
# Its verifier is its own code, the same text as bin/kit-pin's (install test VT1): a verifier read from the
# install would be checking itself.
#
set -uo pipefail

hook=${0##*/}
refuse() {   # REASON [LINE...]: the refusal, then each line after it, as written ("You can: ...")
    echo "kit stub ($hook): REFUSING -- $1." >&2
    shift
    while (( $# )); do echo "  $1" >&2; shift; done
    exit 1
}

# The stub's only pass is the hand-over at the end: exec replaces this process with the release's hook, so this trap
# never runs after it, and that hook then passes only from its own pass point. Any other exit 0 -- an early exit, or a
# stop on an unset variable that the shell reports as 0, as bash 3.2 can -- is turned into a refusal here. A
# refusal's own non-zero exit, a failed exec's among them, is left as it is.
kit_passed=0
kit_guard() {
    local rc=$?
    if [[ $rc -eq 0 && "${kit_passed:-0}" != 1 ]]; then
        echo "kit stub ($hook): REFUSING -- the check stopped before it finished, so what it had not reached was never checked." >&2
        exit 1
    fi
}
trap kit_guard EXIT

# ---- an org's hook, and the project's own, first -----------------------------------------------
# When an org's IT sets core.hooksPath at the system or global level, kit-pin to gives this clone its own path, on the
# stubs, so git runs this stub and not the org's hook. So the stub runs that hook first, as git would: by its own path,
# with the same arguments and standard input, from the top of the work tree, where git starts every hook (a hook that
# calls its siblings finds them through its own path, as under git). Then a hook of the project's own that kit-pin kept
# as <hook>.project. Either refusing refuses, before any of the kit's checks, so the kit scans what gets committed.
# An org's hook that isn't an executable file is skipped, as git skips it: the org's lane. The kept hook is the kit's
# to run, so it is never skipped: one that isn't an executable file refuses, as hook-checks/ refuses such an entry.
# Nothing here keeps an org's hook from running (install_test HO, HG, HP, HX).
first=(); whose=()   # each hook to run first, and whose it is: it (IT's hooks path) or project
if [[ -z "${KIT_STUB_CHAINING:-}" ]]; then
    # The global path, else the system one, from the values git itself reads (GIT_CONFIG_NOSYSTEM skips the system
    # file for git, but not for `git config --system`; install test HN2).
    org=$(git config --show-scope --includes --type=path --get-all core.hooksPath 2>/dev/null \
          | awk '{ i = index($0, "\t"); s = substr($0, 1, i - 1) } s == "global" || s == "system" { v = substr($0, i + 1) }
                 END { print v }') || org=""
    if [[ -n "$org" ]]; then
        f="$org/$hook"; [[ "$f" == /* ]] || f="$PWD/$f"
        [[ -f "$f" && -x "$f" && ! "$f" -ef "$0" ]] && { first+=("$f"); whose+=(it); }
    fi
    f="${0%/*}/$hook.project"; [[ "$f" == /* ]] || f="$PWD/$f"
    if [[ -e "$f" || -L "$f" ]]; then
        [[ -f "$f" && -x "$f" ]] || refuse "$f, this project's own $hook that kit-pin kept, is not an executable file" \
            "Restore its execute bit (chmod +x $f) or remove it. The kit runs it before its own checks and never skips it."
        [[ "$f" -ef "$0" ]] || { first+=("$f"); whose+=(project); }
    fi
fi
refs=""
if (( ${#first[@]} )); then
    if [[ "$hook" == pre-push ]]; then refs=$(cat; printf .); refs=${refs%.}; fi
    i=0
    for f in "${first[@]}"; do
        if [[ "$hook" == pre-push ]]; then printf '%s' "$refs" | KIT_STUB_CHAINING=1 "$f" "$@"; rc=${PIPESTATUS[1]}
        else KIT_STUB_CHAINING=1 "$f" "$@"; rc=$?; fi
        if (( rc != 0 )); then
            [[ "${whose[$i]}" != it ]] || refuse "$f refused (exit $rc)" \
                "If IT manages this machine: it is IT's own hook, run before the kit's checks as git would run it; what it printed above says why."
            refuse "$f refused (exit $rc)" \
                "The project's owner: it is this project's own hook, run before the kit's checks as git would run it; what it printed above says why."
        fi
        i=$((i + 1))
    done
fi

# SHA-256 by sha256sum where it is installed, else by shasum -a 256, which a stock Mac has instead: one routine, the
# same text in each script that hashes (install test HS1). kit_sha256 hashes stdin and prints what sha256sum prints;
# kit_no_sha256 succeeds, saying why, only when neither tool is installed, and the caller refuses then.
kit_sha256() {
    if command -v sha256sum >/dev/null 2>&1; then sha256sum
    elif command -v shasum >/dev/null 2>&1; then shasum -a 256
    else return 127; fi
}
kit_no_sha256() {
    if command -v sha256sum >/dev/null 2>&1 || command -v shasum >/dev/null 2>&1; then return 1; fi
    printf 'neither sha256sum (GNU coreutils) nor shasum (Perl) is installed'
}

kit_verify_install() {   # DIR RELEASE MANIFEST-HASH: 0, or 1 with KV_ERROR saying why
    local dir=$1 rel=$2 want=$3 got sum path n=0 extra
    KV_ERROR=""
    if [[ ! -d "$dir" ]]; then KV_ERROR="no install for $rel in ${dir%/*}"; return 1; fi
    got=$(sed -n 's/^tag=//p' "$dir/RELEASE" 2>/dev/null)
    if [[ "$got" != "$rel" ]]; then KV_ERROR="the install's RELEASE names ${got:-no tag}, not $rel"; return 1; fi
    got=$(kit_sha256 < "$dir/MANIFEST.sha256" 2>/dev/null) || got=""
    if [[ -z "$got" || "sha256:${got%% *}" != "$want" ]]; then KV_ERROR="the install's manifest doesn't match the pin"; return 1; fi
    while read -r sum path; do
        n=$((n + 1))
        if [[ ! -f "$dir/$path" ]]; then KV_ERROR="$path is missing from the install"; return 1; fi
        got=$(kit_sha256 < "$dir/$path") || got=""
        if [[ "${got%% *}" != "$sum" ]]; then KV_ERROR="$path in the install doesn't match its manifest line"; return 1; fi
    done < "$dir/MANIFEST.sha256"
    if (( n == 0 )); then KV_ERROR="the install's manifest lists no files"; return 1; fi
    extra=$(cd "$dir" && find . ! -type d ! -path ./MANIFEST.sha256 | sed 's|^\./||' | LC_ALL=C sort \
            | LC_ALL=C comm -23 - <(awk '{print $2}' MANIFEST.sha256 | LC_ALL=C sort)) || extra="(a file list that could not be read)"
    if [[ -n "$extra" ]]; then KV_ERROR="${extra%%$'\n'*} is in the install but not in its manifest"; return 1; fi
    return 0
}

case "$hook" in pre-commit|pre-push) ;; *) refuse "it runs only as pre-commit or pre-push, not as $hook" ;; esac
top=$(git rev-parse --show-toplevel 2>/dev/null) || refuse "git could not name this clone's top folder"
root=${KIT_INSTALL_ROOT:-${HOME:-}/.local/share/morrowcairn/releases}
# A kit-pin command a refusal names runs from inside the project: the pinned install's by its absolute path, or, where
# that install is missing or fails its manifest, "$INST" or "$KIT" with the line saying what it is (install test PC15
# to PC19).
[[ -f "$top/kit.pin" ]] || refuse "no kit.pin in this clone's top folder" \
    "Pin a release (\"\$INST/bin/kit-pin\" to vX.Y.Z; INST is that release's install, in $root), or restore kit.pin from this project's history."
release=""; manifest=""; lines=0
while IFS= read -r line || [[ -n "$line" ]]; do
    lines=$((lines + 1))
    case "$line" in
        release=*)  release=${line#release=} ;;
        manifest=*) manifest=${line#manifest=} ;;
    esac
done < "$top/kit.pin"
if [[ $lines -ne 2 || ! "$release" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ || ! "$manifest" =~ ^sha256:[0-9a-f]{64}$ ]]; then
    refuse "kit.pin is malformed" "It holds two lines: release=vX.Y.Z and manifest=sha256:<64 hex>."
fi

if why=$(kit_no_sha256); then refuse "$why, so the install can't be checked against kit.pin"; fi
# An install this process can't see may be missing, or hidden: under Claude Code's sandbox read block a sandboxed
# command sees the install and every folder up to ~/.local as "No such file or directory", the error a missing one
# gives, so the two can't be told apart; letting sandboxed commands read the release folder and gitleaks' made the same
# commit pass (measured; install_test ST3b, ST3c). So the refusal names both, and the folders.
if ! kit_verify_install "$root/$release" "$release" "$manifest"; then
    [[ -d "$root/$release" ]] || refuse "$KV_ERROR" "It is missing, or hidden from this process (a sandbox that blocks reading the home folder makes it look missing)." \
        "You can: if it is hidden by a sandbox read block you set yourself, add $root, gitleaks' folder and the do-not-publish list's folder, ~/.config/morrowcairn/lists, to sandbox.filesystem.allowRead in your user settings; if it is missing, rebuild it from this project (\"\$KIT/bin/kit-pin\" restore \"\$KIT\"; KIT is your clone of the kit's public repository)." \
        "If IT manages this machine: a sandbox read policy may block the install folder, $root, gitleaks' folder or the do-not-publish list's folder (~/.config/morrowcairn/lists): ask IT to allow reading them rather than changing it in your own settings, and to allow running from the install folder where the home folder is mounted noexec or programs are allow-listed."
    refuse "$KV_ERROR" "You can: rebuild the pinned install from this project (\"\$KIT/bin/kit-pin\" restore \"\$KIT\"; KIT is your clone of the kit's public repository), or move the pin (\"\$KIT/bin/kit-pin\" to vX.Y.Z)."
fi
kp_cmd="\"$root/$release/bin/kit-pin\""
# kit-pin to refuses while the work tree has changes, and at a commit the refused commit's change is staged: so the
# commit's steps set it aside first and bring it back after (install test PC25).
if [[ "$hook" == pre-commit ]]; then
    differs="You can: set the staged changes aside, refresh the stub, bring them back, then commit again: git stash; $kp_cmd to $release; git stash pop --index"
else
    differs="You can: refresh it ($kp_cmd to $release), and see what else is off ($kp_cmd check)."
fi
cmp -s "$0" "$root/$release/leak-detection/stub-hook" \
    || refuse "this stub differs from release $release's copy" "$differs"
# The manifest holds contents, not modes: a release hook that lost its execute bit would fail to run, so say so.
[[ -x "$root/$release/leak-detection/$hook" ]] \
    || refuse "release $release's $hook is not executable, so it can't run" "You can: rebuild the install from this project ($kp_cmd restore \"\$KIT\"; KIT is your clone of the kit's public repository)." \
           "If IT manages this machine: where the home folder is mounted noexec or programs are allow-listed, ask IT to allow running from $root."

# ---- a hook added to a chained folder after kit-pin ran ---------------------------------------
# Where kit-pin chains a hooks path (an org's, or the clone's former one), it records it in .kit-hooks beside the stubs
# and writes a relay only for the hooks it held then: git starts a process for every hook it finds, so a relay for each
# name would slow every git command. A hook added there later, or a hooks path IT has
# moved, would then be skipped by git without a word. So a commit refuses, naming it and the fix, while a recorded
# folder holds an executable hook of a name below with no relay here, or git reads another org hooks path than the one
# recorded. Names no relay carries (push-to-checkout, proc-receive, fsmonitor-watchman) and names git doesn't document
# as hooks are kit-pin check's to name, never refused. Builtins only: this runs at every commit.
kit_relayed="applypatch-msg pre-applypatch post-applypatch pre-merge-commit prepare-commit-msg commit-msg post-commit
    pre-rebase post-checkout post-merge pre-receive update post-receive post-update reference-transaction pre-auto-gc
    post-rewrite sendemail-validate post-index-change"
is_relay() {   # FILE: one of kit-pin's relays, by its third line
    local a="" b="" l=""
    [[ -f "$1" && ! -L "$1" ]] || return 1
    { IFS= read -r a; IFS= read -r b; IFS= read -r l; } < "$1" 2>/dev/null
    [[ "$l" == *"the relay git runs in a pinned clone"* ]]
}
here=${0%/*}; [[ "$here" == /* ]] || here="$PWD/$here"
if [[ "$hook" == pre-commit && -z "${KIT_STUB_CHAINING:-}" && -f "$here/.kit-hooks" ]]; then
    ch_org=""; ch_former=""
    { IFS= read -r ch_org || :; IFS= read -r ch_former || :; } < "$here/.kit-hooks"
    repin="You can: set the staged changes aside, run kit-pin to again, bring them back, then commit: git stash; $kp_cmd to $release; git stash pop --index"
    [[ "$org" == "$ch_org" ]] || refuse "git reads ${org:-no org hooks path} now, but this clone relays the hooks of ${ch_org:-no org hooks path}" "$repin"
    unrelayed=""
    for n in $kit_relayed; do
        for d in "$ch_org" "$ch_former"; do
            [[ -n "$d" ]] || continue
            [[ "$d" == /* ]] || d="$top/$d"
            [[ -f "$d/$n" && -x "$d/$n" ]] && ! is_relay "$here/$n" && unrelayed="$unrelayed $d/$n"
        done
    done
    if [[ -n "$ch_former" ]]; then   # a former path's pre-commit and pre-push run through relays kept as <hook>.project
        d=$ch_former; [[ "$d" == /* ]] || d="$top/$d"
        for n in pre-commit pre-push; do
            [[ -f "$d/$n" && -x "$d/$n" ]] && ! is_relay "$here/$n.project" && unrelayed="$unrelayed $d/$n"
        done
    fi
    [[ -z "$unrelayed" ]] || refuse "a hooks path this clone chains holds hooks it doesn't relay, so git would skip them:$unrelayed" "$repin"
fi

export KIT_INSTALL="$root/$release"
# ---- the pass point: the hand-over -------------------------------------------------------------
kit_passed=1
# pre-push's ref lines, read above for a hook that ran first, go on to the release's hook the same.
if [[ "$hook" == pre-push ]] && (( ${#first[@]} )); then exec "$KIT_INSTALL/leak-detection/$hook" "$@" < <(printf '%s' "$refs"); fi
exec "$KIT_INSTALL/leak-detection/$hook" "$@"
